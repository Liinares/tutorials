<?xml version="1.0"?>
<odoo>
    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="context">{'search_default_available': True}</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <record id="estate_property_list" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list decoration-success="state in ['offer_recieved', 'offer_accepted']"
                decoration-bf="state == 'offer_accepted'"
                decoration-danger="state == 'cancelled'"
                decoration-muted="state == 'sold'">
                <field name="name" />
                <field name="property_type_id" />
                <field name="postcode" />
                <field name="bedrooms" />
                <field name="living_area" string="Living Area (sqm)" />
                <field name="expected_price" />
                <field name="selling_price" />
                <field name="date_availability" string="Available From" optional="hide" />
            </list>
        </field>
    </record>

    <record id="estate_property_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Estate Property">
                <header>
                    <button string="Sold" name="sold_property" type="object"
                        invisible="state in ['sold', 'cancelled'] " decoration-primary="True" />
                    <button string="Cancel" name="cancel_property" type="object"
                        invisible="state in ['sold', 'cancelled']" />
                    <field name="state" widget="statusbar"
                        statusbar_visible="new,offer_recieved,offer_accepted,sold"
                        options="{'clickable': True}" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" />
                    <group>
                        <group>
                            <field name="property_type_id" options="{'no_create': True}" />
                            <field name="state" />
                            <field name="postcode" />
                            <field name="date_availability" />
                        </group>
                        <group>
                            <field name="expected_price" />
                            <field name="selling_price" />
                            <field name="best_offer" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <group>
                                <field name="description" />
                                <field name="bedrooms" />
                                <field name="living_area" />
                                <field name="facades" />
                                <field name="garage" />
                                <field name="garden" />
                                <field name="garden_area" invisible="garden == False" />
                                <field name="garden_orientation" invisible="garden == False" />
                                <field name="total_area" />
                            </group>
                        </page>
                        <page string="Offers" name="offers">
                            <field name="offer_ids"
                                readonly="state in ['sold', 'cancelled', 'offer_accepted']">
                                <list editable="top"
                                    decoration-success="status == 'accepted'"
                                    decoration-danger="status == 'refused'">
                                    <field name="price" />
                                    <field name="validity" />
                                    <field name="date_deadline" />
                                    <field name="partner_id" />
                                    <button name="confirm_offer" string="Confirm" type="object"
                                        icon="fa-check" invisible="status" />
                                    <button name="cancel_offer" string="Cancel" type="object"
                                        icon="fa-times" invisible="status" />
                                </list>
                            </field>
                        </page>
                        <page string="Other Info" name="description">
                            <group>
                                <field name="salesperson" />
                                <field name="buyer" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="property_type_id" />
                <field name="postcode" />
                <field name="expected_price" />
                <field name="bedrooms" />
                <field name="living_area" filter_domain="[('living_area','&gt;',self)]" />
                <field name="facades" />
                <group>
                    <filter string="Available" name="available"
                        domain="[('active', '=', True),
                    '|',
                    ('state', '=', 'new'),
                    ('state', '=', 'offer_recieved')]" />
                </group>
                <group>
                    <filter string="Postcode" name="postcode" context="{'group_by': 'postcode'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="estate_property_kanban" model="ir.ui.view">
        <field name="name">estate.property.kanban</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <kanban default_group_by="property_type_id">
                <field name="state" />
                <field name="offer_ids" />
                <templates>
                    <t t-name="kanban-box">
                        <div>
                            <strong>
                                <field name="name" />
                            </strong>
                            <br></br>
                            <div
                                t-if="record.offer_ids.raw_value.length > 0"> Best Offer: <field
                                    name="best_offer" />
                            </div> Expected
                            price: <field name="expected_price" />
                            <div
                                t-if="record.offer_ids.raw_value.some(offer => offer.status === 'accepted')">
                            Selling price: <field name="selling_price" />
                            </div>
                            <field
                                name="tag_ids" />
                            <div t-if="record.state.raw_value == 'new'">
                                This is new!
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>