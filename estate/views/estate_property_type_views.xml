<?xml version="1.0"?>
<odoo>
    <record id="estate_property_type_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="estate_property_type_list" model="ir.ui.view">
        <field name="name">estate.property.type.list</field>
        <field name="model">estate.property.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="sequence" widget="handle" />
            </list>
        </field>
    </record>

    <record id="estate_property_type_form" model="ir.ui.view">
        <field name="name">estate.property.type.from</field>
        <field name="model">estate.property.type</field>
        <field name="arch" type="xml">
            <form>
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="estate.estate_property_offer_action" type="action"
                        class="oe_stat_button" icon="fa-money">
                        <field name="offer_count" widget="statinfo" />
                    </button>

                </xpath>

                <div class="oe_title">
                    <h1>
                        <field name="name" />
                    </h1>
                </div>
                <sheet>
                    <notebook>
                        <page string="Properties" name="description">
                            <field name="property_ids">
                                <list>
                                    <field name="name" />
                                    <field name="expected_price" />
                                    <field name="state" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>

            </form>
        </field>
    </record>

</odoo>