<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="model_real_estate_property_offer" model="ir.model">
        <field name="name">Property Offer</field>
        <field name="model">x_estate_saas.property.offer</field>
    </record>

    <!-- x_price -->
    <record id="field_property_offer_price" model="ir.model.fields">
        <field name="model_id" ref="estate_saas.model_real_estate_property_offer" />
        <field name="name">x_price</field>
        <field name="field_description">Price</field>
        <field name="ttype">float</field>
        <field name="required">1</field>
    </record>

    <!-- x_status -->
    <record id="field_property_offer_status" model="ir.model.fields">
        <field name="model_id" ref="estate_saas.model_real_estate_property_offer" />
        <field name="name">x_status</field>
        <field name="field_description">Status</field>
        <field name="ttype">selection</field>
    </record>

    <!-- Selecciones del campo x_status -->
    <record id="sel_property_offer_status_accepted" model="ir.model.fields.selection">
        <field name="field_id" ref="estate_saas.field_property_offer_status" />
        <field name="value">accepted</field>
        <field name="name">Accepted</field>
        <field name="sequence">1</field>
    </record>
    <record id="sel_property_offer_status_refused" model="ir.model.fields.selection">
        <field name="field_id" ref="estate_saas.field_property_offer_status" />
        <field name="value">refused</field>
        <field name="name">Refused</field>
        <field name="sequence">2</field>
    </record>

    <!-- x_partner_id -->
    <record id="field_property_offer_partner_id" model="ir.model.fields">
        <field name="model_id" ref="estate_saas.model_real_estate_property_offer" />
        <field name="name">x_partner_id</field>
        <field name="field_description">Partner</field>
        <field name="ttype">many2one</field>
        <field name="on_delete">restrict</field>
        <field name="relation">res.partner</field>
        <field name="required">1</field>
    </record>

    <!-- x_property_id -->
    <record id="field_property_offer_property_id" model="ir.model.fields">
        <field name="model_id" ref="estate_saas.model_real_estate_property_offer" />
        <field name="name">x_property_id</field>
        <field name="field_description">Property</field>
        <field name="ttype">many2one</field>
        <field name="on_delete">restrict</field>
        <field name="relation">x_estate_saas.property</field>
        <field name="required">1</field>
    </record>


    <!-- ACTIONS -->
    <record id="action_x_estate_saas_property_offer_accept" model="ir.actions.server">
        <field name="name">Accept</field>
        <field name="model_id" ref="estate_saas.model_real_estate_property_offer" />
        <field name="state">code</field>
        <field name="code"><![CDATA[
            for property in records:
                property.write({'x_status': 'accepted'})
                property.x_property_id.write({'x_selling_price': property.x_price})
                property.x_property_id.write({'x_partner_id': property.x_partner_id})
        ]]>
    </field>
    </record>

</odoo>