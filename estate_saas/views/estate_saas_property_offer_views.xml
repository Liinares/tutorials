<?xml version="1.0"?>
<odoo>
    <record id="estate_saas_property_offer_action" model="ir.actions.act_window">
        <field name="name">Property offers</field>
        <field name="res_model">x_estate_saas.property.offer</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="estate_saas_property_offer_list" model="ir.ui.view">
        <field name="name">estate.saas.property.offer.list</field>
        <field name="model">x_estate_saas.property.offer</field>
        <field name="arch" type="xml">
            <list>
                <field name="x_price" />
                <field name="x_partner_id" />
                <field name="x_status" />
                <button name="estate_saas.action_x_estate_saas_property_offer_accept" type="action"
                    string="Accept" />
            </list>
        </field>
    </record>

    <record id="estate_saas_property_offer_form" model="ir.ui.view">
        <field name="name">estate.property.offer.form</field>
        <field name="model">x_estate_saas.property.offer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="x_price" />
                        <field name="x_partner_id" />
                        <field name="x_status" />
                        <field name="x_property_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>