<?xml version="1.0"?>
<odoo>
    <record id="estate_saas_property_tag_action" model="ir.actions.act_window">
        <field name="name">Property tags</field>
        <field name="res_model">x_estate_saas.property.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="estate_saas_property_tag_list" model="ir.ui.view">
        <field name="name">estate.saas.property.tag.list</field>
        <field name="model">x_estate_saas.property.tag</field>
        <field name="arch" type="xml">
            <list>
                <field name="x_name" />
            </list>
        </field>
    </record>

    <record id="estate_saas_property_tag_form" model="ir.ui.view">
        <field name="name">estate.property.tag.form</field>
        <field name="model">x_estate_saas.property.tag</field>
        <field name="arch" type="xml">
            <form string="Estate Property tag">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="x_name" />
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

</odoo>