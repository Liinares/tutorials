<?xml version="1.0"?>
<odoo>
    <record id="estate_saas_property_type_action" model="ir.actions.act_window">
        <field name="name">Property Types</field>
        <field name="res_model">x_estate_saas.property.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="estate_saas_property_type_list" model="ir.ui.view">
        <field name="name">estate.saas.property.type.list</field>
        <field name="model">x_estate_saas.property.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="x_name" />
            </list>
        </field>
    </record>

    <record id="estate_saas_property_type_form" model="ir.ui.view">
        <field name="name">estate.property.type.form</field>
        <field name="model">x_estate_saas.property.type</field>
        <field name="arch" type="xml">
            <form string="Estate Property Type">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="x_name" />
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

</odoo>